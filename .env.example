# ============================================================
# BORC Backend - Environment variables
# คัดลอกไฟล์นี้เป็น ".env" แล้วกรอกค่าจริง (ห้าม commit ไฟล์ .env)
# ============================================================

# ── App / CORS ──────────────────────────────────────────────
# "production" = ใช้ cookie แบบ secure + samesite=none, ไม่เปิด localhost origins
# ค่าอื่น/ว่าง = โหมด local dev
ENV=development

# URL ของ frontend / backend / chatbot service ที่ต้องอนุญาตใน CORS origins
Frontend_BORC_URL=http://localhost:5173
Backend_BORC_URL=http://localhost:8000
ChatBot_URL=http://localhost:5000

# ── MongoDB (Atlas) ────────────────────────────────────────────
MONGODB_ALART_CLIENT_URL=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?appName=Cluster0

# ── JWT (ใช้ร่วมกันทั้ง Admin และ User ผ่าน common/jwt_utils.py) ─
# สุ่มค่าใหม่ที่ยาวและสุ่มจริงสำหรับ production เช่น: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-jwt-secret-here

# ── Inter-service auth (Backend -> ChatBot) ────────────────────
# ค่าลับที่ backend แนบไปกับทุก request ที่ยิงไปหา ChatBot_URL ผ่าน header
# "X-Internal-Secret" เพื่อให้ ChatBot service ตรวจสอบได้ว่า request มาจาก
# backend นี้จริง (ฝั่ง ChatBot service ต้อง validate header เองแยกต่างหาก
# อยู่นอกขอบเขตของ repo นี้)
INTERNAL_SERVICE_SECRET=your-internal-service-secret-here

# ── LINE Login (OAuth 2.0) ──────────────────────────────────────
# ดูค่าได้จาก LINE Developers Console > Login Channel
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=your-line-login-channel-secret
LINE_LOGIN_REDIRECT_URI=http://localhost:5173/LoginUser

# ── Cloudinary (อัปโหลดรูปโปรไฟล์) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── Admin seed account (ใช้ตอนรัน Admin/AddLoginData.py ครั้งแรก) ─
EMAIL_LOGIN=admin@example.com
PASSWORD_LOGIN=change-this-password
